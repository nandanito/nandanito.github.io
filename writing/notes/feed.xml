---
layout: null
permalink: /writing/notes/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/writing/notes/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/writing/notes/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/writing/notes/feed.xml' | absolute_url }}</id>
  <title type="html">{{ site.title | xml_escape }} — Notes</title>
  <subtitle>Shorter informal pieces — paper reading notes, conference reflections, project-status updates.</subtitle>
  {% if site.categories.notes %}
  {% assign notes_posts = site.categories.notes | sort: 'date' | reverse %}
  {% for post in notes_posts limit: 20 %}
    <entry>
      <title type="html">{{ post.title | xml_escape }}</title>
      <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.modified | default: post.date | date_to_xmlschema }}</updated>
      <id>{{ post.url | absolute_url }}</id>
      <content type="html" xml:base="{{ post.url | absolute_url }}"><![CDATA[{{ post.content | strip }}]]></content>
      <author>
        <name>{{ site.title | xml_escape }}</name>
      </author>
      {% if post.tags %}{% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}{% endif %}
      {% if post.excerpt %}<summary type="html">{{ post.excerpt | strip_html | xml_escape | truncate: 280 }}</summary>{% endif %}
    </entry>
  {% endfor %}
  {% endif %}
</feed>
